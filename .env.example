# Токен бота от @BotFather (впишите сами, никому не показывайте)
BOT_TOKEN=

# Публичный HTTPS-адрес приложения (туннель cloudflared или адрес хостинга)
WEBAPP_URL=

# Telegram ID пользователей через запятую, кому разрешён доступ.
# Пусто = доступ открыт всем (режим для тестов).
ALLOWED_USER_IDS=

# Путь к файлу базы данных SQLite
DATABASE_PATH=data/veroniks.db

# Необязательно: ключ Anthropic API. Если пусто — работает движок правил без ИИ.
ANTHROPIC_API_KEY=

# Необязательно: модель для ИИ-режима (пусто = claude-opus-5-5)
ANTHROPIC_MODEL=
